# Component versions bundled into the release packages.
# Bump these when a CS2 update breaks things, then run the "Release package" workflow.

# Upstream ed0ard/CS2-Bot-Improver release used as the base package
# (Panel, gameinfo.gi, botprofile .vpk files, configs and anything else not built here).
BASE_REPO=ed0ard/CS2-Bot-Improver
BASE_TAG=v1.4.6

# CounterStrikeSharp release tag (roflmuffin/CounterStrikeSharp).
# v1.0.378 is the first build that works on CS2 1.41.9.2 (Oct 23, 2026).
CSS_TAG=v1.0.378

# Metamod:Source 2.0 dev build number, or "latest".
# CSS v1.0.378 is built against Metamod build 1483.
MMS_BUILD=1483
